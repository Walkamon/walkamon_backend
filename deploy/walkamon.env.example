# Copy to /etc/walkamon/walkamon.env and chmod 600.
# Generate long URL-safe random values; never commit the populated file.
# Quote values that contain spaces or shell punctuation.
API_IMAGE=ghcr.io/walkamon/walkamon_backend:main
MSSQL_SA_PASSWORD=REPLACE_WITH_32_PLUS_CHARACTER_PASSWORD
WALKAMON_DB_PASSWORD=REPLACE_WITH_DIFFERENT_32_PLUS_CHARACTER_PASSWORD
JWT_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_BYTES

SMTP_USERNAME=REPLACE_ME
SMTP_APP_PASSWORD='REPLACE_ME_WITHOUT_DISPLAY_SPACES'
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME
GOOGLE_AUTH_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com

FIREBASE_PROJECT_ID=REPLACE_ME
ANDROID_PACKAGE_NAME=REPLACE_ME
ANDROID_CERTIFICATE_SHA256=REPLACE_WITH_64_HEX_CHARACTERS
CORS_WEB_ORIGIN=https://purple-island-059194d00.7.azurestaticapps.net
SWAGGER_ENABLED=true

CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME

# Read-only GHCR credentials. Leave blank if the package is public.
GHCR_USERNAME=REPLACE_ME
GHCR_TOKEN=REPLACE_WITH_PACKAGES_READ_TOKEN

# Private Cloudflare R2 bucket named walkamon-backups.
RESTIC_REPOSITORY=s3:https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com/walkamon-backups
RESTIC_PASSWORD=REPLACE_WITH_LONG_UNIQUE_RESTIC_PASSWORD
AWS_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_KEY

# SQL Server Express allows at most 10 GB of data files per database.
WALKAMON_DB_WARNING_MB=7168
